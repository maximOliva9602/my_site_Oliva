# ── Налаштування сервера ──
PORT=3000
# Часовий пояс студії (важливо для слотів/нагадувань). На Railway теж задайте.
TZ=Europe/Kyiv

# ── Онлайн-чат / адмін-панель / CRM ──
# Пароль власника для входу на /admin і /cabinet (ОБОВʼЯЗКОВО задайте на Railway!)
ADMIN_PASSWORD=

# Railway автоматично виставляє NODE_ENV=production (для secure-cookie).
# Локально можна не задавати.
# NODE_ENV=production

# ── База даних CRM (SQLite) ──
# Абсолютний шлях на ЗМОНТОВАНОМУ Railway Volume, інакше дані зникнуть при редеплої.
# Приклад для тому, змонтованого на /app/data:
DB_FILE=/app/data/oliva.db

# ── Сповіщення клієнтам (Viber/SMS) ──
# Драйвер: console (лог, локально) | telegram (у студійний чат) | turbosms (Viber→SMS)
NOTIFY_DRIVER=console
# Адреса студії у тексті нагадувань
STUDIO_ADDRESS=м. Київ, вул. Борщагівська, 145
# Друге нагадування за N годин (0 = вимкнено; напр. 2.5)
REMINDER2_HOURS=0
# Мінімальний запас від «зараз» для онлайн-слотів на сьогодні (хв)
LEAD_MIN=0

# ── TurboSMS (коли буде акаунт) ──
# Bearer-токен з кабінету turbosms.ua
TURBOSMS_TOKEN=
# Зареєстроване Alpha-ім'я відправника SMS
TURBOSMS_SENDER=Oliva
# Зареєстроване ім'я Viber-відправника (якщо відрізняється)
TURBOSMS_VIBER_SENDER=Oliva
# Секрет для вебхука статусів /api/webhooks/turbosms?secret=...
TURBOSMS_WEBHOOK_SECRET=

# ── Telegram (для чату й telegram-драйвера сповіщень) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

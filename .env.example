# ── Налаштування сервера ──
PORT=3000
# Часовий пояс студії (важливо для слотів/нагадувань). На Railway теж задайте.
TZ=Europe/Kyiv

# ── Онлайн-чат / адмін-панель / CRM ──
# Пароль власника для входу на /admin і /cabinet (ОБОВʼЯЗКОВО задайте на Railway!)
ADMIN_PASSWORD=

# Railway автоматично виставляє NODE_ENV=production (для secure-cookie).
# Локально можна не задавати.
# NODE_ENV=production

# ── База даних CRM (SQLite) ──
# Абсолютний шлях на ЗМОНТОВАНОМУ Railway Volume, інакше дані зникнуть при редеплої.
# Приклад для тому, змонтованого на /app/data:
DB_FILE=/app/data/oliva.db

# ── Сповіщення клієнтам (Viber/SMS) ──
# Драйвер: console (лог) | telegram (у студійний чат) | turbosms (Viber→SMS) | alphasms (чисті SMS, поштучно)
NOTIFY_DRIVER=console
# Адреса студії у тексті нагадувань
STUDIO_ADDRESS=м. Київ, вул. Борщагівська, 145
# Телефон студії у тексті нагадувань/підтверджень
STUDIO_PHONE=+380974340112
# Друге нагадування за N годин (0 = вимкнено; напр. 2.5)
REMINDER2_HOURS=0
# Мінімальний запас від «зараз» для онлайн-слотів на сьогодні (хв)
LEAD_MIN=0

# ── TurboSMS (коли буде акаунт) ──
# Bearer-токен з кабінету turbosms.ua
TURBOSMS_TOKEN=
# Зареєстроване Alpha-ім'я відправника SMS
TURBOSMS_SENDER=Oliva
# Зареєстроване ім'я Viber-відправника (якщо відрізняється)
TURBOSMS_VIBER_SENDER=Oliva
# Секрет для вебхука статусів /api/webhooks/turbosms?secret=...
TURBOSMS_WEBHOOK_SECRET=

# ── AlphaSMS (alphasms.ua) — чисті SMS, оплата поштучно (без місячних пакетів) ──
# Щоб увімкнути цей драйвер: NOTIFY_DRIVER=alphasms
# API-ключ із кабінету alphasms.ua (розділ «API» / ключ доступу)
ALPHASMS_KEY=
# Погоджене альфа-ім'я відправника (те, що ви реєструєте в кабінеті AlphaSMS).
# До погодження можна лишити порожнім — оператор підставить службове ім'я,
# і клієнт побачить НЕ «Oliva». Тож для брендованих SMS дочекайтесь погодження.
ALPHASMS_SENDER=Oliva
# (необов'язково) URL JSON-API; типово https://alphasms.ua/api/json.php
# ALPHASMS_API=https://alphasms.ua/api/json.php

# ── Telegram (для чату й telegram-драйвера сповіщень) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Телефон власника для SMS-фолбеку сповіщення про новий відгук (/api/review),
# коли Telegram недоступний. Шле той самий alphasms-драйвер, що й нагадування
# клієнтам — потребує налаштованого ALPHASMS_KEY вище.
OWNER_VIBER_PHONE=

# ── Web Push (сповіщення майстрам/власнику про нові записи в браузер/PWA) ──
# Згенерувати: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# (необов'язково) контактний mailto/URL для VAPID; типово mailto:admin@massage-oliva.com
# VAPID_SUBJECT=
